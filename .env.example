# ==========================================================================
# Zenoscribe environment variables
#
# Copy this file to `.env` in the same directory and fill in real values:
#     cp .env.example .env
#
# `.env` is git-ignored. NEVER commit real secrets. Commit this file only.
# ==========================================================================

# --- Required ---------------------------------------------------------------

# Postgres login. Read by docker-compose.yml's `db` service (Compose
# substitutes ${POSTGRES_USER} etc. from this file automatically) to
# initialize the Postgres container on first boot against an empty volume -
# matches docker-compose.prod.yml's pattern. NOT read by the app itself
# (config.py only reads DATABASE_URL below) - if you change these, update
# DATABASE_URL to match too, or the app will keep trying the old login.
# Changing these after `pgdata` already has data has no effect until that
# volume is reset (Postgres only applies its own init vars once, against an
# empty data directory).
POSTGRES_USER=zenoscribe
POSTGRES_PASSWORD=zenoscribe
POSTGRES_DB=zenoscribe

# Postgres connection string. REQUIRED in every mode (the app refuses to
# start without it - no hardcoded fallback in config.py). Must match
# POSTGRES_USER/PASSWORD/DB above if you're running against
# docker-compose.yml's `db` service.
DATABASE_URL=postgresql://zenoscribe:zenoscribe@localhost:5432/zenoscribe

# Soniox API key. Get one at https://console.soniox.com
# Required for all transcription and translation features.
SONIOX_API_KEY=

# JWT signing secret used to sign/verify login tokens.
# REQUIRED in production (the app refuses to start without it).
# In development a random secret is generated per run, which invalidates
# existing tokens on every restart. Generate a strong value with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Redis connection string. REQUIRED in production (rate limiting has no
# in-memory fallback - see rate_limit.py). In development, defaults to the
# `redis` service in docker-compose.yml if left unset (that service sets
# this explicitly to redis://redis:6379/0, since "localhost" from inside a
# container wouldn't reach it - see that file's `web` environment block).
# Running uvicorn directly on the host (no Docker) needs a real Redis
# reachable at this URL - e.g. `docker compose up redis` on its own.
REDIS_URL=redis://localhost:6379/0

# --- Initial admin account --------------------------------------------------
# Seeded on first startup only, if no admin exists yet.
# In production, ADMIN_PASSWORD must be set and at least 8 characters,
# or the app refuses to auto-create the admin.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Runtime mode -----------------------------------------------------------
# development | testing | production
ENV=development

# Dev only: rotate the JWT secret on every server startup, so restarting the
# dev server forces every open page to log in again. Ignored in production
# (production always uses the fixed JWT_SECRET so deploys don't log users out).
DEV_ROTATE_JWT_ON_RESTART=false

# JWT token lifetime in hours. After this, the token expires and the user is
# sent back to login on their next page load or API call. 8 = a work day.
TOKEN_HOURS=8

# --- Soniox network timeouts (seconds, optional) ----------------------------
# Lower these in CI to fail fast.
SONIOX_UPLOAD_TIMEOUT=30
SONIOX_POLL_REQUEST_TIMEOUT=10
SONIOX_TRANSCRIPTION_INIT_TIMEOUT=10
# Override the Soniox REST base URL (rarely needed).
# SONIOX_REST_URL=https://api.soniox.com

# --- Test hooks (CI / dev only) ---------------------------------------------
# Enables internal endpoints that simulate upstream failures for E2E tests.
# Keep false in any real deployment.
ALLOW_TEST_HOOKS=false
TEST_HOOK_SECRET=
RESTRICT_TEST_HOOK_TO_LOCALHOST=true

# --- Debugging (optional) ---------------------------------------------------
# When true, translate.py logs token text (may contain user speech).
# Leave false in production.
DEBUG_TOKENS=false

# --- Recording storage backend (optional) -----------------------------------
# local (default): writes to voice_transcriber/recordings/ - fine for a
#   single container/dev, but not shared across replicas.
# minio: uses the MinIO service in docker-compose.yml (opt-in there) or any
#   other self-hosted S3-compatible endpoint - required in production.
#   See voice_transcriber/storage/ and SCALABILITY_DESIGN.md §2.
# STORAGE_BACKEND=minio
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=zenoscribe-dev
# MINIO_SECRET_KEY=zenoscribe-dev-secret
# MINIO_BUCKET=zenoscribe-recordings
# MINIO_SECURE=false
