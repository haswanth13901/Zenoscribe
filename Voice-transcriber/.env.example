# Zenoscribe example environment variables
# Copy to .env and fill values. Do NOT commit real secrets.

# Soniox API key (required for transcription)
SONIOX_API_KEY=

# JWT signing secret. Required in production; in development a generated
# secret is tolerated but not recommended for deployment.
JWT_SECRET=

# Initial admin account. In production set a secure ADMIN_PASSWORD.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Environment: development | testing | production
ENV=development

# Test-hook settings (use only in CI/dev)
ALLOW_TEST_HOOKS=false
TEST_HOOK_SECRET=
RESTRICT_TEST_HOOK_TO_LOCALHOST=true

# Optional tuning/debugging
DEBUG_TOKENS=false
