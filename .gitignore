# --- Secrets & config ---
# Never commit real keys. .env / .env.<ENV> (e.g. .env.production) hold the
# Soniox key, JWT secret, and admin credentials. Commit the .example files
# instead.
.env
.env.*
*.env
!.env.example
!.env.production.example

# --- Application data ---
# SQLite database (users, recording metadata, presence).
app.db
app.db-journal
app.db-wal
app.db-shm
*.sqlite
*.sqlite3

# Saved audio and transcripts - user data, can be large, regenerated at runtime.
/voice_transcriber/recordings/
!/voice_transcriber/recordings/.gitkeep

# --- Frontend (frontend/, the single source dir for all frontend files) ---
frontend/node_modules/
frontend/dist/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/
ENV/

# --- Tooling / editors ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Machine-specific Claude Code permissions (e.g. Windows-only .venv/Scripts
# paths, literal PIDs from a debugging session) - these don't belong in the
# committed .claude/settings.json, which stays cross-platform and repo-wide.
# Claude Code merges this file in automatically if present; nobody has to
# create it themselves.
.claude/settings.local.json

# --- Test / coverage ---
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Scratch / personal notes ---
Update_Roadmap.txt