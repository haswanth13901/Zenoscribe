# --- Secrets & config ---
# Never commit real keys. .env holds the Soniox key, JWT secret, and admin
# credentials. Commit .env.example instead.
.env
*.env
!.env.example

# --- Application data ---
# SQLite database (users, recording metadata, presence).
app.db
app.db-journal
app.db-wal
app.db-shm
*.sqlite
*.sqlite3

# Saved audio and transcripts - user data, can be large, regenerated at runtime.
recordings/
!recordings/.gitkeep

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/
ENV/

# --- Tooling / editors ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# --- Test / coverage ---
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/