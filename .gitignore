# --- Secrets & config ---
# Never commit real keys. .env / .env.<ENV> (e.g. .env.production) hold the
# Soniox key, JWT secret, and admin credentials. Commit the .example files
# instead.
.env
.env.*
*.env
!.env.example
!.env.production.example

# --- Application data ---
# SQLite database (users, recording metadata, presence).
app.db
app.db-journal
app.db-wal
app.db-shm
*.sqlite
*.sqlite3

# Saved audio and transcripts - user data, can be large, regenerated at runtime.
/voice_transcriber/recordings/
!/voice_transcriber/recordings/.gitkeep

# --- Frontend (frontend/, the single source dir for all frontend files) ---
frontend/node_modules/
frontend/dist/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/
ENV/

# --- Tooling / editors ---
# Per-developer tooling config, not project config. .claude/ holds Claude Code's
# tool permissions and machine-specific paths (Windows-only .venv/Scripts entries,
# literal PIDs from a debugging session) - same category as .vscode/ and .idea/.
# Untracked as of PR #35; the directory is recreated locally on first run and
# needs no setup by anyone cloning the repo.
.vscode/
.claude/
.idea/
*.swp
.DS_Store
Thumbs.db

# --- Test / coverage ---
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Scratch / personal notes ---
Update_Roadmap.txt