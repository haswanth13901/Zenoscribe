# ==========================================================================
# Zenoscribe production environment variables
#
# Copy this file to `.env.production` in the repo root and fill in real
# values:
#     cp .env.production.example .env.production
#
# `.env.production` is git-ignored. NEVER commit real secrets. Commit this
# file only.
#
# `ENV=production` itself must ALSO be set as a real process environment
# variable (e.g. `-e ENV=production` on `docker run`, or your platform's
# environment/secrets UI) - the app reads ENV to decide *which* dotenv file
# to load, so it can't discover that decision from inside the file being
# selected. Everything else below can live in this file.
# ==========================================================================

# --- Runtime mode -----------------------------------------------------------
ENV=production

# --- TLS (nginx + certbot) ---------------------------------------------------
# Your real production domain. Used by scripts/init-letsencrypt.sh and the
# `certbot` Compose service's `-d` flag. Must also be hand-edited into
# frontend/nginx.conf's server_name/ssl_certificate lines - see that file's
# header comment for why this isn't templated from this one value instead.
DOMAIN=your-domain.example.com

# Email Let's Encrypt sends certificate expiry/registration notices to -
# the one place you'll hear about a broken renewal before the cert lapses
# and users start seeing browser TLS errors. Keep it monitored.
CERTBOT_EMAIL=

# --- Required in production --------------------------------------------------

# Postgres credentials. Used two ways depending on how you deploy:
#   - docker-compose.prod.yml: reads these three directly (via Compose's
#     --env-file, not env_file:) to configure the `db` container AND to
#     build DATABASE_URL for `web` automatically - you do not need to also
#     set DATABASE_URL below in that path. Never leave these as the
#     `zenoscribe`/`zenoscribe` dev defaults - those are public in this
#     repo's git history.
#   - any other deployment (bare `docker run`, systemd, PaaS): these three
#     are unused; set DATABASE_URL directly instead.
POSTGRES_USER=zenoscribe
POSTGRES_PASSWORD=
POSTGRES_DB=zenoscribe

# Postgres connection string. Required in production if NOT using
# docker-compose.prod.yml (which derives this from POSTGRES_* above) -
# there is no dev fallback.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/zenoscribe

# Soniox API key. Get one at https://console.soniox.com. Get a NEW key here
# for production - do not reuse a developer's local/dev key. The app
# refuses to start without this in production.
SONIOX_API_KEY=

# JWT signing secret. REQUIRED in production (the app refuses to start
# without it) and must stay stable across deploys, or every deploy logs all
# users out. Generate with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Redis connection string. REQUIRED in production (the app refuses to start
# without it) - production rate limiting has no in-memory fallback, since a
# per-process counter loses precision the moment more than one `web`
# replica is running (see rate_limit.py, docs/audits/SCALABILITY_AUDIT.md
# finding F2).
# docker-compose.prod.yml's `redis` service and this default work together
# out of the box; only change this if you're running Redis elsewhere.
# NEVER expose Redis's port to the public internet (docker-compose.prod.yml
# already keeps it off the host via `expose:`, not `ports:`).
REDIS_URL=redis://redis:6379/0

# --- Recording storage (MinIO) - REQUIRED in production ----------------------
# STORAGE_BACKEND must be "minio" in production - the app refuses to start
# otherwise (a local-disk recording isn't visible to any other replica; see
# docs/audits/SCALABILITY_AUDIT.md finding F1). docker-compose.prod.yml's
# `minio` service and these defaults work together out of the box; only
# change them if you're pointing at a different self-hosted S3-compatible
# endpoint.
# NEVER expose MinIO's API/console ports to the public internet.
STORAGE_BACKEND=minio
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=zenoscribe-recordings
MINIO_SECURE=false

# --- Initial admin account --------------------------------------------------
# Seeded on first startup only, if no admin exists yet. Must be at least 8
# characters or the app refuses to auto-create the admin in production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Runtime tuning -----------------------------------------------------------

# JWT token lifetime in hours. 8 = a work day.
TOKEN_HOURS=8

# REQUIRED in production (the app refuses to start without it) - promoted
# from "strongly recommended" once more than one replica became a supported
# topology: stamped into every issued JWT and re-checked on every request
# (auth.py); a token whose `boot` doesn't match the running process's is
# rejected. With N replicas, each generating its own random value, a token
# issued by replica A would be rejected by replica B - every user would see
# random 401s depending on which replica a load balancer routed them to
# (see docs/audits/SCALABILITY_AUDIT.md finding F3). Set to a fixed value
# (e.g. another `secrets.token_urlsafe(16)`, generated once) and put it
# here so every
# replica reads the SAME value - restarting one replica no longer logs
# everyone out, and a rolling deploy across replicas keeps working
# sessions intact. There is still no way to revoke one single session
# early - see DEPLOYMENT.md.
SERVER_BOOT_ID=

# Postgres connection pool size, PER REPLICA (db.py). Total connections
# against Postgres is roughly (replica count) x DB_POOL_MAX_SIZE - keep
# that comfortably under Postgres's max_connections (100 by default),
# leaving headroom for the one-shot `migrate` service and any manual admin
# connections. Rule of thumb: DB_POOL_MAX_SIZE <= (max_connections - 10) /
# expected_max_replica_count. Default (10) is sized for a single replica;
# shrink it as you scale out (e.g. 3 replicas -> 10 each is already 30, safe
# under the default 100; 8+ replicas at 10 each starts getting close and
# should shrink to ~6-8).
DB_POOL_MAX_SIZE=10

# Seconds a process may reuse its own last_seen write for a given user
# before writing again. users.last_seen feeds only the admin console's
# online/offline indicator, so minute-level accuracy is ample - and writing
# it on every authenticated request (the pre-debounce behaviour, restored by
# setting this to 0) cost one Postgres row version per request per active
# user. Higher = fewer writes, coarser presence.
LAST_SEEN_DEBOUNCE_SEC=60

# Seconds a replica waits, on SIGTERM, for active live transcription/
# translation sessions to wrap up and persist their recording before
# exiting (server.py). Must be shorter than however long your orchestrator
# waits before SIGKILL-ing the container - docker-compose.prod.yml's `web`
# service sets a matching `stop_grace_period`; keep the two in sync if you
# change this.
GRACEFUL_SHUTDOWN_GRACE_SEC=30

# --- Soniox network timeouts (seconds, optional) ----------------------------
SONIOX_UPLOAD_TIMEOUT=30
SONIOX_POLL_REQUEST_TIMEOUT=10
SONIOX_TRANSCRIPTION_INIT_TIMEOUT=10

# --- Must stay disabled in production ----------------------------------------
# Test hooks simulate upstream failures for E2E tests; the app refuses to
# start in production if this is true.
ALLOW_TEST_HOOKS=false
TEST_HOOK_SECRET=
RESTRICT_TEST_HOOK_TO_LOCALHOST=true

# Logs token text (may contain user speech). Never enable in production.
DEBUG_TOKENS=false

# Dev-only JWT rotation convenience; ignored in production regardless of
# this value, but keep it false for clarity.
DEV_ROTATE_JWT_ON_RESTART=false
