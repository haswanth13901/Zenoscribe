# ==========================================================================
# Zenoscribe production environment variables
#
# Copy this file to `.env.production` in the repo root and fill in real
# values:
#     cp .env.production.example .env.production
#
# `.env.production` is git-ignored. NEVER commit real secrets. Commit this
# file only.
#
# `ENV=production` itself must ALSO be set as a real process environment
# variable (e.g. `-e ENV=production` on `docker run`, or your platform's
# environment/secrets UI) - the app reads ENV to decide *which* dotenv file
# to load, so it can't discover that decision from inside the file being
# selected. Everything else below can live in this file.
# ==========================================================================

# --- Runtime mode -----------------------------------------------------------
ENV=production

# --- Required in production --------------------------------------------------

# Postgres credentials. Used two ways depending on how you deploy:
#   - docker-compose.prod.yml: reads these three directly (via Compose's
#     --env-file, not env_file:) to configure the `db` container AND to
#     build DATABASE_URL for `web` automatically - you do not need to also
#     set DATABASE_URL below in that path. Never leave these as the
#     `zenoscribe`/`zenoscribe` dev defaults - those are public in this
#     repo's git history.
#   - any other deployment (bare `docker run`, systemd, PaaS): these three
#     are unused; set DATABASE_URL directly instead.
POSTGRES_USER=zenoscribe
POSTGRES_PASSWORD=
POSTGRES_DB=zenoscribe

# Postgres connection string. Required in production if NOT using
# docker-compose.prod.yml (which derives this from POSTGRES_* above) -
# there is no dev fallback.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/zenoscribe

# Soniox API key. Get one at https://console.soniox.com. Get a NEW key here
# for production - do not reuse a developer's local/dev key. The app
# refuses to start without this in production.
SONIOX_API_KEY=

# JWT signing secret. REQUIRED in production (the app refuses to start
# without it) and must stay stable across deploys, or every deploy logs all
# users out. Generate with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# --- Initial admin account --------------------------------------------------
# Seeded on first startup only, if no admin exists yet. Must be at least 8
# characters or the app refuses to auto-create the admin in production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Runtime tuning -----------------------------------------------------------

# JWT token lifetime in hours. 8 = a work day.
TOKEN_HOURS=8

# Stamped into every issued JWT and re-checked on every request; a token
# whose `boot` doesn't match the running process's is rejected (auth.py).
# Left unset, a fresh random value is generated per process start, so EVERY
# restart (not just a redeploy - `docker compose restart`, a crash loop, a
# host reboot) logs out every logged-in user. Set this to a fixed value
# (e.g. another `secrets.token_urlsafe(16)`, generated once) if you instead
# want sessions to survive restarts within the same deployment. There is no
# way to revoke a single session early either way - see DEPLOYMENT.md.
SERVER_BOOT_ID=

# --- Soniox network timeouts (seconds, optional) ----------------------------
SONIOX_UPLOAD_TIMEOUT=30
SONIOX_POLL_REQUEST_TIMEOUT=10
SONIOX_TRANSCRIPTION_INIT_TIMEOUT=10

# --- Must stay disabled in production ----------------------------------------
# Test hooks simulate upstream failures for E2E tests; the app refuses to
# start in production if this is true.
ALLOW_TEST_HOOKS=false
TEST_HOOK_SECRET=
RESTRICT_TEST_HOOK_TO_LOCALHOST=true

# Logs token text (may contain user speech). Never enable in production.
DEBUG_TOKENS=false

# Dev-only JWT rotation convenience; ignored in production regardless of
# this value, but keep it false for clarity.
DEV_ROTATE_JWT_ON_RESTART=false
